<?xml version="1.0"?>
<ORE>
  <Setup>
    <Parameter name="asofDate">2026-02-07</Parameter>
    <Parameter name="inputPath">Input</Parameter>
    <Parameter name="outputPath">Output/Experiment7</Parameter>
    <Parameter name="logFile">log_sofr.txt</Parameter>
    <Parameter name="logMask">31</Parameter>
    <Parameter name="marketDataFile">market_sofr.txt</Parameter>
    <Parameter name="fixingDataFile">../../Input/fixings_20160205.txt</Parameter>
    <Parameter name="implyTodaysFixings">N</Parameter>
    <Parameter name="curveConfigFile">curveconfig_sofr.xml</Parameter>
    <Parameter name="conventionsFile">conventions_sofr.xml</Parameter>
    <Parameter name="marketConfigFile">todaysmarket_sofr.xml</Parameter>
    <Parameter name="pricingEnginesFile">../../Input/pricingengine.xml</Parameter>
    <Parameter name="portfolioFile">portfolio_sofr.xml</Parameter>
    <Parameter name="observationModel">None</Parameter>
    <Parameter name="continueOnError">false</Parameter>
    <Parameter name="calendarAdjustment">../../Input/calendaradjustment.xml</Parameter>
    <Parameter name="currencyConfiguration">../../Input/currencies.xml</Parameter>
  </Setup>
  <Markets>
    <Parameter name="lgmcalibration">libor</Parameter>
    <Parameter name="fxcalibration">libor</Parameter>
    <Parameter name="eqcalibration">libor</Parameter>
    <Parameter name="pricing">libor</Parameter>
    <Parameter name="simulation">libor</Parameter>
  </Markets>
  <Analytics>
    <Analytic type="npv">
      <Parameter name="active">Y</Parameter>
      <Parameter name="baseCurrency">USD</Parameter>
      <Parameter name="outputFileName">npv_sofr.csv</Parameter>
      <Parameter name="additionalResults">Y</Parameter>
    </Analytic>
    <Analytic type="cashflow">
      <Parameter name="active">Y</Parameter>
      <Parameter name="outputFileName">flows_sofr.csv</Parameter>
    </Analytic>
    <Analytic type="curves">
      <Parameter name="active">Y</Parameter>
      <Parameter name="configuration">default</Parameter>
      <Parameter name="grid">240,1M</Parameter>
      <Parameter name="outputFileName">curves_sofr.csv</Parameter>
      <Parameter name="outputTodaysMarketCalibration">Y</Parameter>
    </Analytic>
  </Analytics>
</ORE>
